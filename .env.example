# Obrigatório: chave do OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Opcionais (defaults entre parênteses). Ids no formato OpenRouter "autor/modelo".
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PLANNING_MODEL=openai/gpt-5.5              # estrutura do carrossel + revisão de slides
# CHAT_MODEL=openai/gpt-5.4-mini             # respostas conversacionais do chat (mais barato)
# TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe  # ditado por voz (sem stream no OpenRouter)
# IMAGE_MODEL=google/gemini-3-pro-image      # fundos dos slides (via chat completions)
# IMAGE_FALLBACK_MODEL=google/gemini-3.1-flash-image  # usado se o principal recusar/filtrar
# IMAGE_SIZE=1088x1360                       # tamanho final normalizado (4:5)
# IMAGE_QUALITY=medium                       # usado apenas pelos modelos gpt-image (assets)
# ASSET_IMAGE_MODEL=openai/gpt-image-1       # "Criar imagem" no editor: ativos com fundo transparente
# LAYOUT_REFINE=true                         # reposiciona h1/texto sobre a imagem gerada (agente de visão + métricas)

# Vídeo / animação (Remotion)
# NODE_BIN=node                      # caminho do Node usado pelo renderer
# MEDIA_ORIGIN=http://127.0.0.1:8000 # origem para o Chromium baixar o PNG do slide
# RENDER_TIMEOUT=600                 # timeout (s) por clipe renderizado
# MOTION_FPS=30
